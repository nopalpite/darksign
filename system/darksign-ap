#!/usr/bin/python3
"""darksign: Wi-Fi access point of the player (hostapd + dnsmasq).

Installed by install.sh in /usr/local/sbin (owned by root) and run by the
darksign-ap.service unit, which the web backend starts and stops via sudo.

    darksign-ap run CONFIG.json     prepare the Wi-Fi, start dnsmasq then hostapd
    darksign-ap cleanup             stop dnsmasq, remove the port 80 redirect,
                                    give the Wi-Fi back to NetworkManager
    darksign-ap config CONFIG.json  print the hostapd configuration (test,
                                    password masked)

Why hostapd rather than NetworkManager's access point: the latter also
advertises PSK-SHA256 authentication, which the Pi 3 chip (BCM43430, no PMF)
does not support; the beacons sent by its firmware then no longer match
message 3/4 of the WPA2 handshake and phones (Android, iPhone), strict on
this point, give up. Here: WPA2-PSK only, CCMP, no PMF.

Phones check the Internet access of each Wi-Fi network (Android:
connectivitycheck.gstatic.com/generate_204, Apple: captive.apple.com...) and,
without an answer, send all traffic over mobile data, including to
10.42.0.1. On this network every DNS name therefore points to the player and
port 80 is redirected to its web interface (8080), which answers these
checks (web.py): the phone keeps using the player's Wi-Fi.

The player configuration can be edited by its user: this script imports no
project code and strictly validates the name and password.
"""
import json
import os
import signal
import socket
import subprocess
import sys
import time

ADDRESS = "10.42.0.1"
PREFIX = 24
DHCP_RANGE = "10.42.0.10,10.42.0.250,255.255.255.0,12h"
RUN_DIR = "/run/darksign-ap"
CHANNEL = 6
WEB_PORT = 8080
NFT_TABLE = "darksign_ap"


def fail(msg):
    print(f"darksign-ap : {msg}", file=sys.stderr)
    sys.exit(1)


def wifi_interface():
    """First Wi-Fi interface (usually wlan0)."""
    out = subprocess.run(["iw", "dev"], capture_output=True, text=True).stdout
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("Interface "):
            return line.split()[1]
    fail("no Wi-Fi interface")


def settings(path):
    """Access point name (bytes) and password, validated."""
    try:
        with open(path) as f:
            cfg = json.load(f)
    except (OSError, ValueError) as e:
        fail(f"unreadable configuration: {e}")
    net = cfg.get("network") or {}
    # same rule as common.ap_ssid: configured name, else player name, else
    # hostname; 32 bytes at most
    name = net.get("ap_ssid") or cfg.get("name") or socket.gethostname()
    if not isinstance(name, str) or any(ord(c) < 32 or ord(c) == 127 for c in name):
        fail("invalid access point name")
    ssid = name.encode()
    while len(ssid) > 32:
        name = name[:-1]
        ssid = name.encode()
    if not ssid:
        fail("empty access point name")
    password = net.get("ap_password")
    if not (isinstance(password, str) and 8 <= len(password) <= 63
            and all(32 <= ord(c) < 127 for c in password)):
        fail("invalid access point password (8 to 63 ASCII characters)")
    return ssid, password


def hostapd_conf(iface, ssid, password):
    return "\n".join([
        f"interface={iface}",
        "driver=nl80211",
        f"ssid2={ssid.hex()}",          # hexadecimal: no special characters
        "utf8_ssid=1",
        "hw_mode=g",
        f"channel={CHANNEL}",
        "ieee80211n=1",
        "wmm_enabled=1",
        "auth_algs=1",
        "ignore_broadcast_ssid=0",
        "wpa=2",                         # WPA2 only
        "wpa_key_mgmt=WPA-PSK",          # no PSK-SHA256 (see above)
        "rsn_pairwise=CCMP",
        "ieee80211w=0",                  # no PMF: not supported by the chip
        f"wpa_passphrase={password}",
        "",
    ])


def run(cmd, check=True):
    return subprocess.run(cmd, check=check, capture_output=True, text=True)


def cmd_run(path):
    iface = wifi_interface()
    ssid, password = settings(path)
    os.makedirs(RUN_DIR, mode=0o700, exist_ok=True)
    conf = os.path.join(RUN_DIR, "hostapd.conf")
    fd = os.open(conf, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(hostapd_conf(iface, ssid, password))

    # NetworkManager lets go of the Wi-Fi while the access point runs (the
    # Ethernet cable stays managed); not persistent: back after a reboot
    run(["nmcli", "device", "set", iface, "managed", "no"], check=False)
    time.sleep(1)
    run(["ip", "addr", "flush", "dev", iface], check=False)
    run(["ip", "addr", "add", f"{ADDRESS}/{PREFIX}", "dev", iface])
    run(["ip", "link", "set", iface, "up"])

    # port 80 of this network -> player web interface (phone connectivity
    # checks, and any address typed leads to the interface)
    run(["nft", "delete", "table", "ip", NFT_TABLE], check=False)   # leftover
    subprocess.run(["nft", "-f", "-"], check=True, text=True, input=f"""
table ip {NFT_TABLE} {{
    chain prerouting {{
        type nat hook prerouting priority dstnat;
        iifname "{iface}" tcp dport 80 redirect to :{WEB_PORT}
    }}
}}
""")

    # DHCP and DNS on the access point network only. Authoritative: a
    # device asking for an old lease gets an immediate refusal and asks for a
    # new one, instead of waiting forever. Every name points to the player
    # (no Internet here, nothing to forward).
    run(["dnsmasq", "--conf-file=/dev/null", f"--interface={iface}",
         "--bind-interfaces", "--except-interface=lo",
         f"--listen-address={ADDRESS}", f"--dhcp-range={DHCP_RANGE}",
         "--dhcp-authoritative", "--no-resolv", "--no-hosts",
         f"--address=/#/{ADDRESS}",
         f"--dhcp-option=option:router,{ADDRESS}",
         f"--dhcp-option=option:dns-server,{ADDRESS}",
         f"--dhcp-leasefile={RUN_DIR}/leases",
         f"--pid-file={RUN_DIR}/dnsmasq.pid", "--log-dhcp"])

    print(f'access point "{ssid.decode(errors="replace")}" on {iface}, '
          f"{ADDRESS}", flush=True)
    os.execv("/usr/sbin/hostapd", ["hostapd", conf])   # in the foreground


def cmd_cleanup():
    try:
        with open(os.path.join(RUN_DIR, "dnsmasq.pid")) as f:
            os.kill(int(f.read().strip()), signal.SIGTERM)
    except (OSError, ValueError):
        pass
    run(["nft", "delete", "table", "ip", NFT_TABLE], check=False)
    iface = wifi_interface()
    run(["ip", "addr", "flush", "dev", iface], check=False)
    # the Wi-Fi goes back to NetworkManager, which joins a saved network
    run(["nmcli", "device", "set", iface, "managed", "yes"], check=False)
    for name in ("hostapd.conf", "dnsmasq.pid"):
        try:
            os.unlink(os.path.join(RUN_DIR, name))
        except OSError:
            pass


def main():
    args = sys.argv[1:]
    if args[:1] == ["run"] and len(args) == 2:
        cmd_run(args[1])
    elif args == ["cleanup"]:
        cmd_cleanup()
    elif args[:1] == ["config"] and len(args) == 2:
        ssid, password = settings(args[1])
        print(hostapd_conf("wlan0", ssid, "*" * len(password)), end="")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
