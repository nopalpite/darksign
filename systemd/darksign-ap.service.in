[Unit]
Description=DarkSign Wi-Fi access point (hostapd + dnsmasq)
# started and stopped on demand by the web backend (network.py), never at
# boot: the backend chooses between venue Wi-Fi and access point
After=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/darksign-ap run @DIR@/data/config.json
# always: the Wi-Fi goes back to NetworkManager, even after a failure
ExecStopPost=/usr/local/sbin/darksign-ap cleanup
Restart=on-failure
RestartSec=3
