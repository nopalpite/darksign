[Unit]
StartLimitIntervalSec=0
Description=DarkSign web interface (port 8080)
After=network.target

[Service]
User=@USER@
Group=@GROUP@
WorkingDirectory=@DIR@
ExecStart=/usr/bin/python3 @DIR@/web.py
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=2
# conversions: above this ceiling, ffmpeg is stopped rather than freezing the Pi
MemoryHigh=300M
MemoryMax=400M
# works even without a memory controller: when memory runs out, the
# conversion is stopped first (ffmpeg inherits this setting)
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
