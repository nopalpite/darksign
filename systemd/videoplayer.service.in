[Unit]
StartLimitIntervalSec=0
Description=DarkSign full-screen video player (mpv)
# Start as early as possible, without waiting for the network or the end of
# boot: the DarkSign intro shows as soon as the graphics card is ready.
DefaultDependencies=no
Wants=dev-dri-card0.device
After=local-fs.target dev-dri-card0.device
Conflicts=shutdown.target
Before=shutdown.target

[Service]
User=@USER@
Group=@GROUP@
WorkingDirectory=@DIR@
ExecStart=/usr/bin/python3 @DIR@/player.py
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=2
# the player is the last process killed when memory runs out
OOMScoreAdjust=-800

[Install]
WantedBy=multi-user.target
